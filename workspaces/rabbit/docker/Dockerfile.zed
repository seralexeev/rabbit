FROM stereolabs/zed:5.5.0-tools-devel-jetson-jp6.1.0

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=src:/usr/local/lib/python3.10/dist-packages

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends iw iputils-ping iproute2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /rabbit
COPY pyproject.toml ./
RUN uv sync
