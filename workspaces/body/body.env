# Rabbit 2.0 body settings, read by every container in compose.yaml and by rabbit-power.service.
# Bring-up order (docs/reports/2026-10-03-architecture-2.0-body.md, "Как переезжает существующий код"):
#   step 5  SAFETY_MODE=shadow, DRIVE_INPUT unset: roboclaw and steering still obey rabbit.cmd.*
#   step 6  SAFETY_MODE=active, DRIVE_INPUT=safety, E-stop wire on S3 (RoboClaw S3 = E-Stop, not latching)
#   step 8  add each sensor to SAFETY_SENSORS once it ran in shadow
NATS_URL=nats://nats:4222
SAFETY_MODE=shadow
DRIVE_INPUT=
SAFETY_SENSORS=
SAFETY_TOF=FL,FR,RL,RR
SAFETY_SELF_TEST=1
SAFETY_INA_ALERT=0
LIDAR_PORT=/dev/ttyAMA4
LIDAR_MOUNT=0.1597,0,0.23,180
LIDAR_MASK=
TOF_SENSORS=FL,FR,RL,RR
TOF_DISTANCE=perpendicular
TOF_FLIP_ROWS=0
TOF_FLIP_COLS=1
TOF_ROLL_DEG=90
POWER_REQUIRE_SAFETY=1
