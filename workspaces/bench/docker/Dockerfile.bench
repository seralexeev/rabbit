# The robot's rabbit image (ZED SDK 5.5, pyzed, CUDA 12.6) plus cuVSLAM 17. Built on the robot:
#   cd /root/bench/src && nice -n 19 docker build -f docker/Dockerfile.bench -t rabbit-bench .
FROM rabbit

ARG CUVSLAM_WHEEL=https://github.com/nvidia-isaac/cuVSLAM/releases/download/v17.0.0/cuvslam-17.0.0%2Bcu12-cp310-cp310-manylinux_2_35_aarch64.whl
RUN uv pip install --python /rabbit/.venv/bin/python "${CUVSLAM_WHEEL}" pyyaml

ENV PATH=/rabbit/.venv/bin:$PATH
WORKDIR /bench
