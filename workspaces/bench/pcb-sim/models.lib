* Discrete device models shared by the decks. Sources: README.md, section "Models".

.param vt_ao3400=1.0 vt_bss138=1.3 kp_bss138=0.21 bv_tpd=10.5

.model MMBT3906 PNP(Is=1.41f Xti=3 Eg=1.11 Vaf=18.7 Bf=180.7 Ne=1.5 Ise=0 Ikf=80m Xtb=1.5 Br=4.977 Nc=2 Isc=0
+ Ikr=0 Rc=2.5 Cjc=9.728p Mjc=.5776 Vjc=.75 Fc=.5 Cje=8.063p Mje=.3677 Vje=.75 Tr=33.42n Tf=179.3p Itf=.4 Vtf=4
+ Xtf=6 Rb=10)
.model D1N4148 D(Is=2.52n Rs=.568 N=1.752 Cjo=4p M=.4 Tt=20n Bv=100 Ibv=100u)
.model BAT54 D(Is=2e-7 N=1.0 Rs=2.0 Cjo=10p M=0.5 Bv=30 Ibv=1e-5 Tt=5n Eg=0.69 Xti=2)
.model B340A D(Is=20u N=1.05 Rs=25m Cjo=200p Bv=40 Ibv=0.5m)
.model B540C D(Is=30u N=1.05 Rs=15m Cjo=300p Bv=40 Ibv=0.5m)
.model DIDEAL D(Is=1e-6 N=0.1 Rs=1m)
.model DFAST D(Is=1e-9 N=1)
.model DBODY D(Is=1e-11 N=1.1 Rs=5m Cjo=1n)
.model DBSS D(Is=1e-12 N=1.2 Rs=0.5 Cjo=10p)
.model DTVS D(Is=1e-12 N=1 Rs=0.5 Bv={bv_tpd} Ibv=1m Cjo=20p)

.subckt AO3400A d g s
M1 d g s s NAO
Cgs g s 600p
Cgd g d 80p
Db s d DBODY
.model NAO NMOS(Level=1 Vto={vt_ao3400} Kp=40 Lambda=0.01)
.ends

.subckt BSC010N04LS d g s
M1 d g s s NBSC
Cgs g s 7n
Cgd g d 0.3n
Db s d DBODY
.model NBSC NMOS(Level=1 Vto=1.7 Kp=150 Lambda=0.001)
.ends

.subckt BSS138 d g s
M1 d g s s NBSS
Cgs g s 20p
Cgd g d 4p
Cds d s 10p
Db s d DBSS
.model NBSS NMOS(Level=1 Vto={vt_bss138} Kp={kp_bss138} Lambda=0.02)
.ends

.subckt TPD1E10B09 a b
Da m a DTVS
Db m b DTVS
C1 a b 10p
.ends

.subckt PASSGATE d g s
M1 d g s 0 NPG
Cd d 0 3p
Cs s 0 3p
.model NPG NMOS(Level=1 Vto=0.9 Kp=0.06 Gamma=0.4 Phi=0.7)
.ends
