{
  "name": "forge",
  "private": true,
  "type": "module",
  "scripts": {
    "forge": "node --liftoff-only src/cli.ts",
    "format": "oxfmt .",
    "tsc": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "check": "oxfmt --check . && tsc --noEmit && oxlint --type-aware && vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.81",
    "@modelcontextprotocol/server": "2.2.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@polyglot-sql/sdk": "0.13.1",
    "ai": "7.0.122",
    "chdb": "3.4.0",
    "minisearch": "7.2.0",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxfmt": "0.67.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
